<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>zhusl.music</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>

	<!-- 应用图标资源。.NET for iOS 是从 Info.plist 读这个键（ReadAppManifest 任务），
	     再作为 app-icon 参数传给 actool；写在 csproj 的 PropertyGroup 里完全无效，
	     会导致 actool 不产图标、装完的应用没有图标。 -->
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/AppIcon.appiconset</string>

	<!-- iOS 14+ 无需 storyboard 文件即可全屏启动；刻意不加 UIApplicationSceneManifest，
	     AvaloniaAppDelegate 会自行管理 window/scene。 -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- 后台播放必需（缺此项锁屏后音频会被挂起）。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 允许 http:// 直连 Navidrome / 局域网 FTP。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- 访问局域网音源时系统会弹权限框，需要这段文案。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问本地网络以连接你配置的局域网音乐服务器（Navidrome / FTP）。</string>

	<!-- Documents 出现在「文件」App / Finder 中，便于导入音乐。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
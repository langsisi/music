<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- AOT/裁剪编译期分析器：构建时扫描本仓库源码的 RequiresDynamicCode/反射风险点，
         CI 日志直接给出清单（IL3050/IL2026 等）。注意只覆盖自研代码，
         NuGet 库与 framework 内部扫不到——黑屏炸点在 framework 内部，
         只能靠下方 MtouchLink=None 解决；将来收紧裁剪时再按此清单逐项处理。 -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- 不依赖 ICU 全球化数据：真机 AOT/裁剪包曾疑似因 ICU 缺失导致 culture 格式化
         抛异常（startup.log/crash.log 均未写出）。中文显示走 CoreText 不受影响，
         全代码库无 GetCultureInfo/new CultureInfo 用法，改为不变全球化是安全的。 -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 版本号与 Core / Android 对齐；ApplicationId 会映射为 CFBundleIdentifier。
         发布时由 scripts/publish-release.ps1 用 -p:Version 覆盖。 -->
    <!-- 1.1.1：真机黑屏排障版本，爱思应用列表可肉眼区分新旧包 -->
    <Version>1.1.1</Version>
    <ApplicationTitle>ZMusic</ApplicationTitle>
    <ApplicationId>zhusl.music</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.1</ApplicationDisplayVersion>

    <!-- 刻意不设 RuntimeIdentifier / RuntimeIdentifiers：
         设置后会让 dotnet build 默认按真机 RID 出包，模拟器调试（-t:Run）会失败。
         真机 / 模拟器 RID 由构建命令用 -p:RuntimeIdentifier 显式指定。 -->

    <!-- 无 Apple 开发者账号时可在 Mac 上用 -p:CodesignKey="" 关闭签名做模拟器调试。 -->
    <CodesignKey>iPhone Developer</CodesignKey>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <XSAppIconAssets>Assets.xcassets/AppIcon.appiconset</XSAppIconAssets>
  </PropertyGroup>

  <!-- AOT / 裁剪：
       iOS 禁止 JIT，真机 Release 由 iOS SDK 自动走 Mono AOT，且强制 PublishTrimmed=true
       （设 false 会报错）。曾用 TrimMode=partial：实测裁掉 framework 内部反射 stub——
       File IO 的 SafeFileHandle 构造委托在运行时触发 "Attempting to JIT compile
       InvokeStub_SafeFileHandle..ctor ... aot-only mode"，第二次起的全部 managed
       文件 IO 静默失败（设置/缓存/歌词封面全灭），是黑屏的头号嫌疑。
       关闭裁剪的正确方式是 MtouchLink=None（保留全部程序集），用包体积换正确性；
       功能稳定后再逐步收紧（partial / TrimmerRootDescriptor）。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeLibVlc=true：iOS 用 AVFoundation 播放器，Core 剔除 VlcAudioPlayer 与
         LibVLCSharp，避免其 iOS 资产的 P/Invoke 触发 DynamicMobileVLCKit 框架链接。 -->
    <ProjectReference Include="..\Music\Music.csproj" AdditionalProperties="ExcludeLibVlc=true" />
  </ItemGroup>

  <!-- LibVLCSharp 的双重兜底剥离。

       背景：ExcludeLibVlc 经 ProjectReference 的 AdditionalProperties 只能影响内层
       「编译」（EXCLUDE_LIBVLC 宏生效），传不进内层 NuGet restore——实测
       Music/obj/project.assets.json 里始终有 LibVLCSharp，于是这个无人引用的
       孤儿程序集一直躺在发布清单里。原先 TrimMode=partial 时 ILLink 顺手把它整个
       裁掉，掩盖了泄漏；改成 MtouchLink=None 后它存活到 xamarin 链接器，其
       @rpath/DynamicMobileVLCKit.framework P/Invoke 让链接器自动追加
       -framework DynamicMobileVLCKit，而仓库从不引用 VideoLAN.LibVLC.iOS
       → ld: framework 'DynamicMobileVLCKit' not found（真机/模拟器通杀）。

       1) _IosDropLibVlcFromPublishGraph：在 ILLink 计算链接输入前把 LibVLCSharp
          摘出发布清单。ManagedAssemblyToLink 由 ResolvedFileToPublish 派生
          （Microsoft.NET.ILLink.targets 的 _ComputeManagedAssemblyToLink），
          摘掉后链接器根本扫不到该 P/Invoke。
       2) _IosDropVlcFrameworkFromLinker：万一框架名仍从别的途径注入，在 clang++
          之前把 DynamicMobileVLCKit 从链接框架列表剔除。iOS 播放走 AVFoundation
          （VlcAudioPlayer.cs 已被 Compile Remove），不链该框架语义正确。 -->
  <Target Name="_IosDropLibVlcFromPublishGraph"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'LibVLCSharp'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'LibVLCSharp'" />
    </ItemGroup>
    <Message Importance="high" Text="[iOS] LibVLCSharp 已从发布清单剥离（若存在）" />
  </Target>

  <Target Name="_IosDropLibVlcFromLinkInputs" AfterTargets="_ComputeManagedAssemblyToLink">
    <ItemGroup>
      <ManagedAssemblyToLink Remove="@(ManagedAssemblyToLink)" Condition="'%(Filename)' == 'LibVLCSharp'" />
    </ItemGroup>
  </Target>

  <Target Name="_IosDropVlcFrameworkFromLinker" BeforeTargets="_LinkNativeExecutable">
    <ItemGroup>
      <_LinkerFrameworks Remove="@(_LinkerFrameworks)"
                          Condition="$([System.String]::Copy('%(Identity)').Contains('DynamicMobileVLCKit'))" />
      <_NativeExecutableFrameworks Remove="@(_NativeExecutableFrameworks)"
                                    Condition="$([System.String]::Copy('%(Identity)').Contains('DynamicMobileVLCKit'))" />
      <_BindingLibraryFrameworks Remove="@(_BindingLibraryFrameworks)"
                                  Condition="$([System.String]::Copy('%(Identity)').Contains('DynamicMobileVLCKit'))" />
      <_MainLinkWith Remove="@(_MainLinkWith)"
                     Condition="$([System.String]::Copy('%(Identity)').Contains('DynamicMobileVLCKit'))" />
    </ItemGroup>
    <Message Importance="high" Text="[iOS] 已从链接框架列表剔除 DynamicMobileVLCKit（若存在）" />
  </Target>
</Project>
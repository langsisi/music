<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 语义化颜色 Token（深浅两套） ============ -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0D12" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#141826" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1C2233" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#10141F" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#080A0F" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#232A3D" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#333C55" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5FA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6AEC4" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B748E" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#7C6BFF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2450" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF5C7A" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="NavActiveBrush" Color="#242B41" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDEFF7" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#EAECF4" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E1E4EE" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CEDE" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14161F" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6274" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B93A7" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6A55F0" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7E3FF" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E23B5C" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="NavActiveBrush" Color="#E7E9F5" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ============ 主题无关 Token ============ -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#7C6BFF" />
        <GradientStop Offset="1" Color="#E15BFF" />
    </LinearGradientBrush>

    <x:Double x:Key="NavRailWidth">228</x:Double>
    <x:Double x:Key="BottomBarHeight">76</x:Double>
    <x:Double x:Key="CompactBreakpoint">900</x:Double>
    <x:Double x:Key="CardRadius">14</x:Double>

</ResourceDictionary>

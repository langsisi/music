<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Music"
             xmlns:converters="using:Music.Converters"
             x:Class="Music.App"
             RequestedThemeVariant="Dark">
             <!-- 深色为主的默认外观；用户可在「设置」中切换为浅色或跟随系统。 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Music/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:PathToBitmapConverter x:Key="PathToBitmap" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Music/Styles/Controls.axaml" />
    </Application.Styles>
</Application>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:Music.ViewModels.Pages"
             xmlns:vm="using:Music.ViewModels"
             xmlns:controls="using:Music.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Music.Views.Pages.LibraryView"
             x:DataType="pages:LibraryViewModel"
             x:CompileBindings="True">

    <StackPanel Spacing="14">

        <!-- 搜索：全宽圆角填充搜索框（参考音流） -->
        <Border Classes="searchbox">
            <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Data="{x:Static controls:AppIcons.Search}"
                      Fill="{DynamicResource TextTertiaryBrush}"
                      Width="20" Height="20" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         PlaceholderText="搜索曲目 / 艺术家 / 专辑"
                         Text="{Binding SearchText}" />
            </Grid>
        </Border>

        <!-- 收藏 / 分类筛选（横滑）+ 播放全部 / 删除分类 -->
        <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <ListBox Classes="chips"
                         ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding SelectedFilter}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryFilter">
                            <TextBlock Text="{Binding Title}" FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Classes="accent small" Content="播放全部"
                        MinWidth="88"
                        IsVisible="{Binding HasTracks}"
                        Command="{Binding PlayAllCommand}" />
                <Button Classes="icon" Width="36" Height="36"
                        ToolTip.Tip="删除当前分类"
                        IsVisible="{Binding CanDeleteCategory}"
                        Command="{Binding DeleteCategoryCommand}">
                    <Path Data="{x:Static controls:AppIcons.Trash}"
                          Fill="{DynamicResource TextTertiaryBrush}"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 新建分类：输入框与按钮之间留出间距 -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" MaxWidth="340" Margin="0,0,10,0"
                     MinHeight="38" VerticalAlignment="Center"
                     PlaceholderText="新分类名称"
                     Text="{Binding NewCategoryName}" />
            <Button Grid.Column="1" Classes="ghost" Content="新建分类" Height="38"
                    MinWidth="88"
                    VerticalAlignment="Center"
                    Command="{Binding CreateCategoryCommand}" />
        </Grid>

        <!-- 删除等操作的失败提示（成功时列表直接刷新，不提示） -->
        <TextBlock Text="{Binding StatusText}"
                   IsVisible="{Binding HasStatus}"
                   FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" />

        <Border Classes="card" Padding="8" IsVisible="{Binding !IsEmpty}">
            <ListBox ItemsSource="{Binding Tracks}"
                     Background="Transparent" BorderThickness="0"
                     MaxHeight="520">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackRowViewModel">
                        <Grid Height="54" Margin="4,2" ClipToBounds="True">

                            <!-- 手机端：左滑露出的删除按钮（位于内容层之下） -->
                            <Border Width="76" HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource DangerBrush}"
                                    CornerRadius="10"
                                    IsVisible="{Binding $parent[ListBox].((pages:LibraryViewModel)DataContext).IsCompact}">
                                <Grid IsVisible="{Binding CanDelete}">
                                    <!-- 图标与文字由 Grid 居中，避免受按钮内容对齐影响 -->
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <Path Data="{x:Static controls:AppIcons.Trash}"
                                              Fill="White" Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="删除" FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 透明按钮铺满整块区域，点击弹出确认菜单 -->
                                    <Button Classes="swipeaction"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            ToolTip.Tip="删除音乐">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Top">
                                                <MenuItem Header="删除后无法恢复，请确认" IsEnabled="False" />
                                                <MenuItem Header="取消" />
                                                <MenuItem Header="确认删除"
                                                          Command="{Binding DeleteCommand}"
                                                          CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 手机端：右滑露出的「加入分类」按钮（位于内容层之下） -->
                            <Border Width="76" HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="10"
                                    IsVisible="{Binding $parent[ListBox].((pages:LibraryViewModel)DataContext).IsCompact}">
                                <Grid IsVisible="{Binding HasCategories}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <Path Data="{x:Static controls:AppIcons.Queue}"
                                              Fill="White" Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="歌单" FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 透明按钮铺满整块区域，点击弹出入 / 移出分类菜单 -->
                                    <Button Classes="swipeaction"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            ToolTip.Tip="加入分类">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <ItemsControl ItemsSource="{Binding Categories}"
                                                              MinWidth="160">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TrackCategoryItem">
                                                            <Button Classes="bare"
                                                                    Command="{Binding ToggleCommand}">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Path Data="{Binding MarkIcon}"
                                                                          Fill="{DynamicResource AccentBrush}"
                                                                          Width="16" Height="16" Stretch="Uniform"
                                                                          VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 内容层：手机端可左滑 / 右滑，桌面端常驻 -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                  Background="{DynamicResource SurfaceBrush}"
                                  PointerPressed="OnRowPointerPressed"
                                  PointerMoved="OnRowPointerMoved"
                                  PointerReleased="OnRowPointerReleased">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>

                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding CoverPath, Converter={StaticResource PathToBitmap}}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <!-- 加入 / 移出分类：桌面端内联常驻，手机端改为右滑露出 -->
                                <Panel Grid.Column="2"
                                       IsVisible="{Binding $parent[ListBox].((pages:LibraryViewModel)DataContext).IsWide}">
                                    <Button Classes="icon" VerticalAlignment="Center"
                                            ToolTip.Tip="加入分类"
                                            IsVisible="{Binding HasCategories}">
                                        <Path Data="{x:Static controls:AppIcons.Queue}"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Width="18" Height="18" Stretch="Uniform" />
                                        <Button.Flyout>
                                            <Flyout Placement="Top">
                                                <ItemsControl ItemsSource="{Binding Categories}"
                                                              MinWidth="160">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TrackCategoryItem">
                                                            <Button Classes="bare"
                                                                    Command="{Binding ToggleCommand}">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Path Data="{Binding MarkIcon}"
                                                                          Fill="{DynamicResource AccentBrush}"
                                                                          Width="16" Height="16" Stretch="Uniform"
                                                                          VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Panel>

                                <!-- 收藏 -->
                                <Button Grid.Column="3" Classes="icon" VerticalAlignment="Center"
                                        ToolTip.Tip="收藏 / 取消收藏"
                                        Command="{Binding $parent[ListBox].((pages:LibraryViewModel)DataContext).ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Data="{Binding FavoriteIcon}"
                                          Fill="{DynamicResource AccentBrush}"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Button>

                                <!-- 播放 -->
                                <Button Grid.Column="4" Classes="icon" VerticalAlignment="Center"
                                        ToolTip.Tip="播放"
                                        Command="{Binding $parent[ListBox].((pages:LibraryViewModel)DataContext).PlayTrackCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Classes="playglyph" Data="{x:Static controls:AppIcons.Play}"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Button>

                                <!-- 桌面端：宽度足够，删除按钮常驻（点击弹出确认菜单） -->
                                <Panel Grid.Column="5"
                                       IsVisible="{Binding $parent[ListBox].((pages:LibraryViewModel)DataContext).IsWide}">
                                    <Button Classes="icon" VerticalAlignment="Center"
                                            ToolTip.Tip="删除音乐"
                                            IsVisible="{Binding CanDelete}">
                                        <Path Data="{x:Static controls:AppIcons.Trash}"
                                              Fill="{DynamicResource DangerBrush}"
                                              Width="18" Height="18" Stretch="Uniform" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Top">
                                                <MenuItem Header="删除后无法恢复，请确认" IsEnabled="False" />
                                                <MenuItem Header="取消" />
                                                <MenuItem Header="确认删除"
                                                          Command="{Binding DeleteCommand}"
                                                          CommandParameter="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Panel>

                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Classes="card" Padding="30" IsVisible="{Binding IsEmpty}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Path Data="{x:Static controls:AppIcons.Library}"
                      Fill="{DynamicResource TextTertiaryBrush}" Stretch="Uniform"
                      Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock Text="曲库还是空的" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="到「设置 → 音源」添加一个文件夹并扫描" HorizontalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>

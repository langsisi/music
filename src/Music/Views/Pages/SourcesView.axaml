<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:Music.ViewModels.Pages"
             xmlns:models="using:Music.Models"
             xmlns:controls="using:Music.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800"
             x:Class="Music.Views.Pages.SourcesView"
             x:DataType="pages:SourcesViewModel">

    <StackPanel Spacing="16">

        <!-- 添加音源 -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="accent" Content="添加本地文件夹"
                    Command="{Binding AddLocalFolderCommand}" />
            <Button Classes="ghost" Content="添加 FTP"
                    Command="{Binding AddFtpCommand}" />
            <Button Classes="ghost" Content="添加 Navidrome"
                    Command="{Binding AddNavidromeCommand}" />
        </StackPanel>

        <!-- 远程音源配置表单（Navidrome / FTP 共用） -->
        <Border Classes="card" Padding="18" IsVisible="{Binding IsEditorOpen}">
            <StackPanel Spacing="14">
                <TextBlock Classes="h2" Text="{Binding EditorTitle}" />

                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="名称（可选）" />
                    <TextBox Text="{Binding EditorName}" PlaceholderText="我的音乐库" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="{Binding AddressLabel}" />
                    <TextBox Text="{Binding EditorAddress}" PlaceholderText="{Binding AddressPlaceholder}" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsFtpEditor}">
                    <TextBlock Classes="section" Text="端口" />
                    <NumericUpDown Value="{Binding EditorPort}" Minimum="1" Maximum="65535"
                                   Increment="1" FormatString="0" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsFtpEditor}">
                    <TextBlock Classes="section" Text="起始目录" />
                    <TextBox Text="{Binding EditorRootPath}" PlaceholderText="/music" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="用户名" />
                    <TextBox Text="{Binding EditorUser}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="密码" />
                    <TextBox Text="{Binding EditorPassword}" PasswordChar="●" />
                </StackPanel>

                <TextBlock Text="{Binding EditorStatusText}" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="accent" Content="保存并同步"
                            IsEnabled="{Binding !IsTesting}"
                            Command="{Binding SaveSourceCommand}" />
                    <Button Classes="ghost" Content="测试连接"
                            IsEnabled="{Binding !IsTesting}"
                            Command="{Binding TestConnectionCommand}" />
                    <Button Classes="ghost" Content="取消"
                            Command="{Binding CancelEditCommand}" />
                </StackPanel>

                <TextBlock FontSize="12" Classes="muted" TextWrapping="Wrap"
                           Text="密码以明文保存在本机设置文件中，仅用于向该服务器认证。" />
            </StackPanel>
        </Border>

        <!-- 扫描进度 -->
        <Border Classes="card" IsVisible="{Binding IsBusy}" Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
            </StackPanel>
        </Border>

        <!-- 扫描结果提示（非忙碌时） -->
        <TextBlock Text="{Binding StatusText}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsVisible="{Binding !IsBusy}" />

        <TextBlock Text="已添加的音源" Classes="section" IsVisible="{Binding HasSources}" />

        <ItemsControl ItemsSource="{Binding Sources}" IsVisible="{Binding HasSources}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:MusicSourceConfig">
                    <Border Classes="card" Margin="0,0,0,10" Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <Path Data="{x:Static controls:AppIcons.Folder}"
                                      Fill="{DynamicResource AccentBrush}" Stretch="Uniform"
                                      Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Summary}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2" Classes="ghost" Content="编辑"
                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                    IsVisible="{Binding CanEdit}"
                                    Command="{Binding $parent[ItemsControl].((pages:SourcesViewModel)DataContext).EditSourceCommand}"
                                    CommandParameter="{Binding}" />

                            <Button Grid.Column="3" Classes="ghost" Content="同步"
                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                    Command="{Binding $parent[ItemsControl].((pages:SourcesViewModel)DataContext).SyncCommand}"
                                    CommandParameter="{Binding}" />

                            <Button Grid.Column="4" Classes="icon" VerticalAlignment="Center"
                                    ToolTip.Tip="移除音源"
                                    Command="{Binding $parent[ItemsControl].((pages:SourcesViewModel)DataContext).RemoveCommand}"
                                    CommandParameter="{Binding}">
                                <Path Data="{x:Static controls:AppIcons.Trash}"
                                      Fill="{DynamicResource TextTertiaryBrush}"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <Border Classes="card" Padding="30" IsVisible="{Binding !HasSources}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Path Data="{x:Static controls:AppIcons.Sources}"
                      Fill="{DynamicResource TextTertiaryBrush}" Stretch="Uniform"
                      Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock Text="还没有添加任何音源" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="先添加一个本地文件夹试试" HorizontalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>

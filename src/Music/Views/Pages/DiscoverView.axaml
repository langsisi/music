<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:Music.ViewModels.Pages"
             xmlns:controls="using:Music.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Music.Views.Pages.DiscoverView"
             x:DataType="pages:DiscoverViewModel">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Margin="0,80,0,0">
        <Border Width="96" Height="96" CornerRadius="48"
                Background="{DynamicResource AccentSoftBrush}">
            <Path Data="{x:Static controls:AppIcons.Explore}"
                  Fill="{DynamicResource AccentBrush}"
                  Width="44" Height="44" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="发现功能即将到来" FontSize="18" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="每日推荐、最近添加、随机推荐等内容，以后会在这里与你见面"
                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                   Classes="muted" HorizontalAlignment="Center" MaxWidth="280" />
    </StackPanel>
</UserControl>

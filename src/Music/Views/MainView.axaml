<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Music.ViewModels"
             xmlns:models="using:Music.Models"
             xmlns:controls="using:Music.Controls"
             xmlns:views="using:Music.Views"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="Music.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="*,Auto,Auto" Background="{DynamicResource AppBackgroundBrush}"
          Classes.compact="{Binding IsCompact}">

        <!-- 页头与内容区的留白按断点切换：桌面 28，手机（~344 DIP 宽）16，避免边距占比过高。 -->
        <Grid.Styles>
            <Style Selector="StackPanel.pagehead">
                <Setter Property="Margin" Value="28,26,28,14" />
            </Style>
            <Style Selector="ScrollViewer.pagebody">
                <Setter Property="Padding" Value="28,0,28,28" />
            </Style>
            <Style Selector="Grid.compact StackPanel.pagehead">
                <Setter Property="Margin" Value="16,18,16,10" />
            </Style>
            <Style Selector="Grid.compact ScrollViewer.pagebody">
                <Setter Property="Padding" Value="16,0,16,20" />
            </Style>
            <!-- 自滚动页面（顶部固定、只滚列表）用 Border 承担同样的页面留白 -->
            <Style Selector="Border.pagebody">
                <Setter Property="Padding" Value="28,0,28,28" />
            </Style>
            <Style Selector="Grid.compact Border.pagebody">
                <Setter Property="Padding" Value="16,0,16,20" />
            </Style>
        </Grid.Styles>

        <!-- ==================== 主区域：导航 + 内容 ==================== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

            <!-- 左侧导航栏（桌面 / 宽屏） -->
            <Border Grid.Column="0"
                    IsVisible="{Binding IsWide}"
                    Width="{StaticResource NavRailWidth}"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- 品牌 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                Margin="22,24,22,20" Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{StaticResource AccentGradientBrush}">
                            <Path Data="{x:Static controls:AppIcons.Play}"
                                  Fill="White" Stretch="Uniform"
                                  Width="15" Height="15"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Music" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <ListBox Classes="navrail"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationItem">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Width="20" Height="20" Stretch="Uniform"
                                          Data="{Binding Icon}"
                                          Fill="{Binding $parent[ListBoxItem].Foreground}" />
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>

            <!-- 内容区：外壳提供统一的页头，滚动由页面自己负责（自带 scroll 容器或固定顶部） -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Classes="pagehead" Spacing="4">
                    <TextBlock Classes="h1" Text="{Binding CurrentPage.Title}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="{Binding CurrentPage.Description}" />
                </StackPanel>

                <!-- 页面自带滚动容器，须撑满内容区高度才能正确滚动 -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>

        </Grid>

        <!-- ==================== 底部播放条 ==================== -->
        <views:PlayerBarView Grid.Row="1" />

        <!-- ==================== 底部标签栏（紧凑 / 手机） ==================== -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsCompact}"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <ListBox Classes="tabbar"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNavItem}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NavigationItem">
                        <StackPanel HorizontalAlignment="Center" Spacing="3" Margin="0,5">
                            <Path Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Data="{Binding Icon}"
                                  Fill="{Binding $parent[ListBoxItem].Foreground}" />
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ==================== 全屏「正在播放」 ==================== -->
        <views:NowPlayingView Grid.Row="0" Grid.RowSpan="3"
                              IsVisible="{Binding IsNowPlayingOpen}" />

    </Grid>
</UserControl>

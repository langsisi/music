<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Music.ViewModels"
             xmlns:controls="using:Music.Controls"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="76"
             x:Class="Music.Views.PlayerBarView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <!-- 曲目信息块（封面 + 标题/歌手），宽屏与紧凑布局共用。 -->
        <DataTemplate x:Key="PlayerInfoTemplate" x:DataType="vm:MainViewModel">
            <Button Classes="bare" HorizontalAlignment="Left"
                    Command="{Binding Player.ExpandCommand}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="8" ClipToBounds="True"
                            Background="{StaticResource AccentGradientBrush}">
                        <Image Stretch="UniformToFill"
                               Source="{Binding Player.CoverPath, Converter={StaticResource PathToBitmap}}" />
                    </Border>
                    <!-- 文本区上限 260；窄屏时由所在列宽度进一步收窄，不再固定成更小的值。
                         ClipToBounds 是跑马灯的前提：歌名超出宽度时靠这里裁掉溢出部分。 -->
                    <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="260"
                                ClipToBounds="True">
                        <controls:MarqueeText Text="{Binding Player.Title}"
                                              FontWeight="SemiBold" FontSize="13.5"
                                              Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Player.Artist}"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 高度改为随内容自适应（MinHeight 兜底）：内容（传输行 + 进度行）比 76 略高，
         固定高度会把进度条裁掉、并让整排按钮贴着顶边。加上下内边距后自动留白，
         播放按钮随之下移，进度条也能完整显示；紧凑版内容矮，仍由 MinHeight 保持 76。 -->
    <Border MinHeight="{StaticResource BottomBarHeight}"
            Padding="0,6"
            Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0">

        <Grid Margin="14,0">

            <!-- ============ 宽屏：左信息 | 中传输+进度 | 右音量 ============ -->
            <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding IsWide}">

                <ContentControl Grid.Column="0" Content="{Binding}"
                                ContentTemplate="{StaticResource PlayerInfoTemplate}" />

                <StackPanel Grid.Column="1" Width="460"
                            VerticalAlignment="Center" Spacing="2">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <!-- 播放模式：随机 → 列表循环 → 单曲循环，一个按钮循环切换 -->
                        <Button Classes="icon toggle" Classes.active="{Binding Player.IsPlayModeActive}"
                                Command="{Binding Player.CyclePlayModeCommand}"
                                ToolTip.Tip="{Binding Player.PlayModeText}">
                            <!-- 固定 20×20 容器；各图标的宽高都按几何包围盒给，保证等比例、居中、不拉伸 -->
                            <Grid Width="20" Height="20"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{x:Static controls:AppIcons.Shuffle}"
                                      IsVisible="{Binding Player.IsShuffleMode}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Width="16" Height="16" Stretch="Uniform" />
                                <Path Data="{x:Static controls:AppIcons.Repeat}"
                                      IsVisible="{Binding Player.IsRepeatAllMode}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Width="18" Height="20" Stretch="Uniform" />
                                <Path Data="{x:Static controls:AppIcons.RepeatOne}"
                                      IsVisible="{Binding Player.IsRepeatOneMode}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Width="18" Height="20" Stretch="Uniform" />
                            </Grid>
                        </Button>

                        <Button Classes="icon" Command="{Binding Player.PreviousCommand}"
                                ToolTip.Tip="上一首">
                            <Path Data="{x:Static controls:AppIcons.SkipPrevious}"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Width="20" Height="20" Stretch="Uniform" />
                        </Button>

                        <Button Classes="icon primary" Command="{Binding Player.TogglePlayCommand}"
                                ToolTip.Tip="播放 / 暂停">
                            <Path Classes="playglyph" Data="{Binding Player.PlayPauseIcon}"
                                  Fill="White" Width="18" Height="18" Stretch="Uniform" />
                        </Button>

                        <Button Classes="icon" Command="{Binding Player.NextCommand}"
                                ToolTip.Tip="下一首">
                            <Path Data="{x:Static controls:AppIcons.SkipNext}"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Width="20" Height="20" Stretch="Uniform" />
                        </Button>

                        <Button Classes="icon" Command="{Binding Player.ToggleFavoriteCommand}"
                                ToolTip.Tip="收藏">
                            <Path Data="{Binding Player.FavoriteIcon}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="20" Height="20" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <!-- 网络音源首次播放需先取流：仅在缓冲时占位，缓冲结束自动收起。 -->
                    <TextBlock Text="{Binding Player.BufferText}"
                               IsVisible="{Binding Player.IsBuffering}"
                               FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />

                    <Grid ColumnDefinitions="44,*,44" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="{Binding Player.PositionText}"
                                   FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <Slider Grid.Column="1" Minimum="0"
                                Maximum="{Binding Player.DurationSeconds}"
                                Value="{Binding Player.PositionSeconds}" />
                        <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}"
                                   FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                </StackPanel>

                <!-- 右：音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="icon" Command="{Binding Player.ToggleMuteCommand}"
                            ToolTip.Tip="静音">
                        <Path Data="{Binding Player.VolumeIcon}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Slider Width="110" Minimum="0" Maximum="100"
                            Value="{Binding Player.Volume}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ============ 紧凑（手机）：左信息吃满剩余宽度 | 右侧一个播放键 ============ -->
            <!-- 只有两列：左列 * 吸收全部剩余空间，文件名不再被右侧的空列挤窄。 -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCompact}">

                <ContentControl Grid.Column="0" Content="{Binding}"
                                ContentTemplate="{StaticResource PlayerInfoTemplate}" />

                <Button Grid.Column="1" Classes="icon primary" Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding Player.TogglePlayCommand}">
                    <Path Classes="playglyph" Data="{Binding Player.PlayPauseIcon}"
                          Fill="White" Width="18" Height="18" Stretch="Uniform" />
                </Button>
            </Grid>

        </Grid>
    </Border>
</UserControl>

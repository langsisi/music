<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Music.ViewModels"
             xmlns:controls="using:Music.Controls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="760"
             x:Class="Music.Views.MetadataSearchPanel"
             x:DataType="vm:PlayerViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="Border.resultrow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.resultrow.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- 全屏面板：覆盖「正在播放」页，可修正元数据后在指定数据源搜索并挑选结果 -->
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}"
          IsVisible="{Binding IsMetadataSearchOpen}">

        <!-- ============ 顶栏 ============ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,14">
            <Button Grid.Column="0" Classes="icon"
                    Command="{Binding CloseMetadataSearchCommand}"
                    ToolTip.Tip="返回">
                <Path Data="{x:Static controls:AppIcons.Close}"
                      Fill="{DynamicResource TextPrimaryBrush}"
                      Width="20" Height="20" Stretch="Uniform" />
            </Button>
            <TextBlock Grid.Column="1" Text="歌词搜索" Classes="section"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,24">
            <StackPanel Spacing="18">

                <!-- ============ 基本信息（可编辑） ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="基本信息（可手动修改后重新搜索）" Classes="group-label" />

                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <Border Classes="setrow">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="标题" Classes="muted"
                                               VerticalAlignment="Center" Width="72" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchTitle}"
                                             PlaceholderText="歌曲标题" />
                                </Grid>
                            </Border>
                            <Border Classes="setrow">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="艺术家" Classes="muted"
                                               VerticalAlignment="Center" Width="72" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchArtist}"
                                             PlaceholderText="歌手" />
                                </Grid>
                            </Border>
                            <Border Classes="setrow">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="专辑" Classes="muted"
                                               VerticalAlignment="Center" Width="72" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchAlbum}"
                                             PlaceholderText="专辑名" />
                                </Grid>
                            </Border>
                            <Border Classes="setrow last">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="年份" Classes="muted"
                                               VerticalAlignment="Center" Width="72" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchYear}"
                                             PlaceholderText="如 1991" />
                                    <Button Grid.Column="2" Classes="ghost small" Margin="10,0,0,0"
                                            Command="{Binding SaveSearchMetadataCommand}"
                                            Content="保存信息" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 搜索 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="搜索" Classes="group-label" />
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SearchProviders}"
                                  SelectedItem="{Binding SelectedSearchProvider}" />
                        <Button Grid.Column="1" Classes="accent small" Margin="10,0,0,0"
                                Command="{Binding SearchMetadataCommand}"
                                IsEnabled="{Binding !IsSearchingMetadata}"
                                Content="搜索" />
                    </Grid>
                </StackPanel>

                <!-- ============ 搜索结果 ============ -->
                <StackPanel Spacing="8" IsVisible="{Binding IsSearchResultsVisible}">
                    <TextBlock Text="搜索结果（点选一条后应用）" Classes="group-label" />

                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetadataSearchResultViewModel">
                                <Button Classes="bare" Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((vm:PlayerViewModel)DataContext).SelectSearchResultCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="resultrow" Classes.selected="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="48" Height="48"
                                                    CornerRadius="9" ClipToBounds="True"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <Image Stretch="UniformToFill" Source="{Binding Cover}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" VerticalAlignment="Center"
                                                    CornerRadius="8" Padding="8,3"
                                                    Background="{DynamicResource SurfaceHoverBrush}">
                                                <TextBlock Text="{Binding LyricsBadge}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="accent" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ApplySearchResultCommand}"
                            Content="应用所选（下载封面 / 歌词）" />
                </StackPanel>

                <TextBlock Text="{Binding MetadataSearchStatusText}" Classes="muted"
                           FontSize="12.5" TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>